{
  "ignorePatterns": [
    { "pattern": "^\\.\\./\\.\\./(issues|discussions|wiki|pulls)" },
    { "pattern": "<owner>" },
    { "pattern": "^\\.\\.?/deploy/" },
    { "pattern": "^\\.\\.?/\\.claude/" }
