{
  "ignorePatterns": [
    { "pattern": "^\\.\\./\\.\\./(issues|discussions|wiki|pulls)" },
    { "pattern": "<owner>" },
    { "pattern": "%3Cowner%3E" },
    { "pattern": "^\\.\\.?/deploy/" },
    { "pattern": "^\\.\\.?/\\.claude/" },
    { "pattern": "^\\./[A-Z][A-Za-z0-9-]*$" },
    { "pattern": "^\\./deploy$" }
  ],
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 403]
}
