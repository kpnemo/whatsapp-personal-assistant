{
  "name": "@wpa/test-utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@testcontainers/postgresql": "11.14.0",
    "@testcontainers/redis": "11.14.0",
    "@wpa/db": "workspace:*",
    "@wpa/shared": "workspace:*",
    "argon2": "0.41.1",
    "ioredis": "5.10.1",
    "jose": "5.9.6",
    "supertest": "7.2.2",
    "testcontainers": "11.14.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.17",
    "@types/supertest": "7.2.0",
    "express": "5.2.1"
  }
}
