{
  "name": "@wpa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@wpa/db": "workspace:*",
    "@wpa/shared": "workspace:*",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "ioredis": "5.10.1",
    "jose": "5.9.6",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "rate-limiter-flexible": "5.0.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.17",
    "@types/supertest": "7.2.0",
    "@wpa/test-utils": "workspace:*",
    "supertest": "7.2.2",
    "tsx": "4.21.0"
  }
}
